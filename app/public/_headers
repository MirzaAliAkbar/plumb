# The service worker must never be served stale, or a fixed release can never
# reach a browser that cached the previous one.
/sw.js
  Cache-Control: no-cache, must-revalidate

# Hashed assets are immutable by construction.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cross-origin isolation is not needed, but keep the worker scope sane and
# allow pdf.js to run its own worker.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
